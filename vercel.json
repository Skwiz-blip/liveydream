{
  "buildCommand": "node scripts/config.js",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://liveydream-admin.vercel.app"
        },
        {
          "key": "Vary",
          "value": "Origin"
        }
      ]
    }
  ]
}
